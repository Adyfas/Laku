var CACHE_NAME = "laku-app-v3";

var APP_SHELL = [
  "/app.html",
  "/css/global.css",
  "/css/tour.css",
  "/javascript/core/appUtils.js",
  "/javascript/core/unitConversion.js",
  "/javascript/core/icons.js",
  "/javascript/core/guidedTour.js",
  "/javascript/core/popup.js",
  "/javascript/core/app.js",
  "/javascript/core/navbar.js",
  "/javascript/core/animations.js",
  "/javascript/apps/hpp/hppApp.js",
  "/javascript/apps/hpp/hppClient.js",
  "/javascript/apps/hpp/hppIngredients.js",
  "/javascript/apps/hpp/hppCalc.js",
  "/javascript/apps/hpp/hppRecipes.js",
  "/javascript/apps/kas/kasApp.js",
  "/javascript/apps/kas/kasClient.js",
  "/javascript/apps/laba/labaApp.js",
  "/javascript/apps/laba/labaClient.js",
  "/javascript/apps/utang/utangApp.js",
  "/javascript/apps/utang/utangClient.js",
  "/javascript/apps/inventory/inventoryApp.js",
  "/javascript/apps/inventory/inventoryClient.js",
  "/javascript/apps/promo/promoApp.js",
  "/javascript/apps/promo/promoClient.js",
  "/font/Manrope-VariableFont_wght.ttf",
  "/icons/icon-192.png",
  "/icons/icon-512.png"
];

// Tailwind CDN (cross-origin). Tidak di-pre-cache saat install (response opaque),
// tapi di-cache saat runtime pertama kali load -> offline tetap bisa generate CSS.
var TAILWIND_CDN = "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4";

// Helper: path aset aplikasi (bukan halaman lain)
function isAppPath(pathname) {
  return (
    pathname === "/manifest.json" ||
    pathname === "/sw.js" ||
    pathname.indexOf("/javascript/") === 0 ||
    pathname.indexOf("/css/") === 0 ||
    pathname.indexOf("/font/") === 0 ||
    pathname.indexOf("/icons/") === 0
  );
}

// Install: cache app shell (per-entry, toleran gagal)
self.addEventListener("install", function (event) {
  event.waitUntil(
    caches.open(CACHE_NAME).then(function (cache) {
      return Promise.all(
        APP_SHELL.map(function (url) {
          return cache.add(url).catch(function (err) {
            console.warn("[Laku SW] gagal cache:", url, err);
          });
        })
      );
    })
  );
  self.skipWaiting();
});

// Activate: bersihkan cache lama
self.addEventListener("activate", function (event) {
  event.waitUntil(
    caches.keys().then(function (keys) {
      return Promise.all(
        keys
          .filter(function (key) {
            return key !== CACHE_NAME;
          })
          .map(function (key) {
            return caches.delete(key);
          })
      );
    })
  );
  self.clients.claim();
});

// Fetch
self.addEventListener("fetch", function (event) {
  var req = event.request;
  if (req.method !== "GET") return;

  var url = new URL(req.url);

  // 1) Tailwind CDN (cross-origin): cache-first, simpan response opaque
  if (url.href === TAILWIND_CDN) {
    event.respondWith(
      caches.match(req).then(function (cached) {
        if (cached) return cached;
        return fetch(req).then(function (response) {
          if (response) {
            var clone = response.clone();
            caches.open(CACHE_NAME).then(function (cache) {
              cache.put(req, clone);
            });
          }
          return response;
        });
      })
    );
    return;
  }

  // 2) Selain Tailwind CDN, hanya tangani same-origin
  if (url.origin !== self.location.origin) return;

  // 3) app.html: stale-while-revalidate + ignoreSearch (dukung ?open=... / ?return=...)
 if (url.pathname === "/app.html" || url.pathname === "/") {
    event.respondWith(
      caches.open(CACHE_NAME).then(function (cache) {
        // Gunakan "/app.html" sebagai fallback cache utama
        var cacheKey = url.pathname === "/" ? "/app.html" : req;

        return cache.match(cacheKey, { ignoreSearch: true }).then(function (cached) {
          var network = fetch(req).then(function (response) {
            if (response && response.status === 200) {
              // Selalu simpan versi terbaru ke cache "/app.html"
              cache.put("/app.html", response.clone());
            }
            return response;
          });

          if (cached && cached.ok) {
            network.catch(function () {}); // abaikan error network di latar belakang
            return cached;
          }
          return network;
        });
      })
    );
    return;
  }

  // 4) Aset aplikasi (JS/CSS/font/icon): cache-first
  if (isAppPath(url.pathname)) {
    event.respondWith(
      caches.match(req).then(function (cached) {
        if (cached) return cached;
        return fetch(req).then(function (response) {
          if (response && response.status === 200) {
            var clone = response.clone();
            caches.open(CACHE_NAME).then(function (cache) {
              cache.put(req, clone);
            });
          }
          return response;
        });
      })
    );
    return;
  }

  // 5) Halaman lain (index/learn/about/kontak): TIDAK di-cache, biarkan network
});
